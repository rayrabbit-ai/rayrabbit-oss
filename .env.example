# ====================================================================
# RayRabbit OSS - Variables de Entorno Core & Seguridad MAESTRO
# ====================================================================
# Secreto Maestro de 256 bits (64 caracteres hex) para cifrado AES-256-GCM
RAYRABBIT_MASTER_SECRET=""

# Salt criptográfico (32 caracteres hex) para derivación de claves PBKDF2
RAYRABBIT_SALT=""

# Configuración de Red del Hub Core
RAYRABBIT_HOST="0.0.0.0"
RAYRABBIT_PORT=8005
RAYRABBIT_LOG_LEVEL="INFO"
